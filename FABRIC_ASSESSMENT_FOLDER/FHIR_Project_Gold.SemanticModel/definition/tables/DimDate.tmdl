	column 'Is Current Month'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b069c4d9-21d7-476a-b3b7-50fa3629cf47
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Current Month]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE(2015,1,1), DATE(2035,12,31) ),
				
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "YearMonth", FORMAT([Date], "YYYY-MM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				
				    "Week Number", WEEKNUM([Date]),
				    "Day", DAY([Date]),
				    "Day Name", FORMAT([Date], "DDD"),
				    "Day Name Full", FORMAT([Date], "DDDD"),
				
				    "Is Weekend",
				        IF ( WEEKDAY([Date], 2) > 5, TRUE(), FALSE() ),
				
				    "Is Current Year",
				        YEAR([Date]) = YEAR(TODAY()),
				
				    "Is Current Month",
				        YEAR([Date]) = YEAR(TODAY()) &&
				        MONTH([Date]) = MONTH(TODAY())
				)

	annotation PBI_Id = a91f64ac9aab4d989fc34e4f8b31fc78

